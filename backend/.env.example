NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
COOKIE_DOMAIN=
TRUST_PROXY=0
SESSION_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=LinkPulse <no-reply@example.com>
PUBLIC_SHORT_DOMAIN=http://localhost:4000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
