{
  "name": "linkpulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "frontend:dev": "vite frontend --config frontend/vite.config.js --host 0.0.0.0",
    "dev:frontend": "npm run frontend:dev",
    "build": "vite build frontend --config frontend/vite.config.js",
    "lint": "eslint .",
    "test": "npm run backend:test",
    "preview": "vite preview frontend --config frontend/vite.config.js --host 0.0.0.0",
    "backend:dev": "node --watch backend/server.js",
    "backend:start": "node backend/server.js",
    "backend:test": "node --test backend/tests/*.test.js",
    "seed:demo": "node backend/scripts/seed-demo.js",
    "admin:bootstrap": "node backend/scripts/bootstrap-admin.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "papaparse": "^5.4.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.13.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.0.0",
    "supertest": "^7.3.1",
    "vite": "^6.4.4"
  }
}
